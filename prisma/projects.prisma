model Project {
    id String @id @default(uuid())
    projectName String 
    repoUrl String 
    liveLink String
    description String

    studentId String
    student Student @relation(fields:[studentId], references:[id], onDelete:Cascade)

 
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@unique([studentId, repoUrl])


    @@map("projects")
}